{
  "name": "mpc-simulator",
  "description": "An interactive MPC autonomous driving simulator that runs in the browser",
  "license": "MIT",
  "homepage": "https://github.com/mative-ai/adss#readme",
  "bugs": {
    "url": "https://github.com/mative-ai/adss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mative-ai/adss.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mpc-simulator/app --",
    "build": "npm run build --workspace @mpc-simulator/app --",
    "bench:qp": "node packages/cli/src/benchQp.ts",
    "sim": "node packages/cli/src/sim.ts",
    "models": "node tools/models/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "verify": "npm run typecheck && npm run lint && npm run prettier:check && npm run check:boundaries && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "three": "^0.187.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
